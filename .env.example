# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/smart-search?retryWrites=true&w=majority

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Vercel Blob ───────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Webhook endpoint: /api/webhooks/stripe
# Events to enable: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ── Duffel (Flights, Stays, Cars) ─────────────────────────────────────────────
DUFFEL_API_TOKEN=duffel_test_xxxxx
DUFFEL_ENABLED=true
# NOTE: Flights work with any valid token. Stays and Cars are SEPARATE Duffel
# products that must be enabled per-account. If stays/search returns 403
# Forbidden, hotels fall back to non-bookable mock results (deep-links) until
# you request Stays access in the Duffel dashboard (Settings → Access).
# Duffel Cars requires the same separate approval — request at duffel.com/cars.
# Set to true only after your Duffel account has Cars API access granted.
DUFFEL_CARS_ENABLED=false

# ── Viator (Experiences) ──────────────────────────────────────────────────────
VIATOR_API_KEY=
VIATOR_ENABLED=false

# ── OpenTable (Restaurants) ───────────────────────────────────────────────────
OPENTABLE_API_KEY=
OPENTABLE_ENABLED=false

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
OPENWEATHERMAP_API_KEY=your_owm_key

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_gmaps_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_gmaps_key

# ── Pinecone (Vector DB for RAG) ──────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=smart-search-profiles

# ── Resend (Email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@smartsearch.app

# ── Shopping — Rainforest API (Amazon proxy, no partner approval) ─────────────
# https://rainforestapi.com — $50/mo, no approval required
# When set, ShoppingAdapter fetches live Amazon products instead of mock data
RAINFOREST_API_KEY=

# ── Digital Services — Namecheap domain availability ─────────────────────────
# https://www.namecheap.com/support/api/intro/
# Required: username, API key, whitelisted client IP (add in Namecheap dashboard)
NAMECHEAP_USERNAME=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=    # your server's outbound IP — must be whitelisted in Namecheap

# ── Digital Services — Provider Directory ────────────────────────────────────
# Freelancer/service providers stored in MongoDB `providers` collection.
# Seed demo data: npx tsx scripts/seed-providers.ts
# No env var required — active when providers collection is non-empty.

# ── Home Services — Provider Directory ───────────────────────────────────────
# Same provider directory (MongoDB `providers`) used for home service providers.
# Providers with schedulingUrl get a Calendly / booking deep link.
# Seed: npx tsx scripts/seed-providers.ts

# ── Health Services — Provider Directory ─────────────────────────────────────
# Same provider directory for health providers.
# Non-directory cards fall back to Zocdoc deep links (no Zocdoc API needed).
# Seed: npx tsx scripts/seed-providers.ts

# ── Vercel Cron ───────────────────────────────────────────────────────────────
CRON_SECRET=your_cron_secret_here

# ── Phase 5 — Webhooks & Revenue ─────────────────────────────────────────────

# Duffel webhook signature secret (from Duffel dashboard → Webhooks)
# Used to verify X-Duffel-Signature on order change / cancellation events.
DUFFEL_WEBHOOK_SECRET=

# Vendor bid API key — vendors include this as `Authorization: Bearer <key>`
# when posting bids to POST /api/vendor/bid.
# Generate with: openssl rand -hex 32
VENDOR_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Observability (GAP_ANALYSIS 1.5) ──
# All optional. Absent = reporting/analytics compile to no-ops.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
